{
  "name": "eac",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental Experience as Code runtime",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "bench:prepare": "pnpm build && node bench/harness/dist/src/cli.js prepare",
    "bench:smoke": "pnpm build && node bench/harness/dist/src/cli.js smoke",
    "bench:preflight-auth": "pnpm build && node bench/harness/dist/src/cli.js preflight-auth",
    "bench:audit": "pnpm build && node bench/harness/dist/src/cli.js audit",
    "bench:run": "pnpm build && node bench/harness/dist/src/cli.js run",
    "bench:run-all": "pnpm build && node bench/harness/dist/src/cli.js run-all",
    "bench:analyze": "pnpm build && node bench/harness/dist/src/cli.js analyze",
    "clean": "tsc -b --clean",
    "eac": "node packages/cli/dist/bin.js",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
