FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

ARG BENCHMARK_COMMIT=development
LABEL org.opencontainers.image.revision=${BENCHMARK_COMMIT}
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY packages ./packages
COPY bench/harness ./bench/harness
RUN pnpm install --frozen-lockfile && pnpm build \
    && mkdir -p /app/packages/core/.evaluation \
    && chown -R node:node /app/packages/core/.evaluation

ENV EAC_APPLICATION_ROOT=/app
ENV EAC_REPOSITORY_ROOT=/app
ENV EAC_BENCHMARK_COMMIT=${BENCHMARK_COMMIT}
USER node
CMD ["node", "bench/harness/dist/src/capability-service.js"]
