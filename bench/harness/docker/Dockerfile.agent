FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS base

ARG BENCHMARK_COMMIT=development
LABEL org.opencontainers.image.revision=${BENCHMARK_COMMIT}
RUN useradd --create-home --uid 10001 agent
WORKDIR /workspace
ENV HOME=/tmp/agent-home

FROM base AS cli-proxy
COPY bench/harness/docker/eac-proxy.mjs /usr/local/bin/eac
RUN chmod 0555 /usr/local/bin/eac

FROM base AS smoke-a

FROM cli-proxy AS smoke-bc

FROM base AS codex
ARG CODEX_VERSION=0.149.0
RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force
COPY bench/harness/docker/run-agent.mjs /usr/local/bin/run-agent
RUN chmod 0555 /usr/local/bin/run-agent
ENTRYPOINT ["/usr/local/bin/run-agent"]

FROM codex AS agent-a

FROM codex AS agent-bc
COPY --from=cli-proxy /usr/local/bin/eac /usr/local/bin/eac
