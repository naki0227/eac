{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naki0227/eac/bench/harness/result.schema.json",
  "title": "EaC isolated benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "condition",
    "task_id",
    "task_prompt",
    "agent",
    "model",
    "reasoning_config",
    "cli_version",
    "implementation_commit",
    "started_at",
    "first_valid_at",
    "ended_at",
    "status",
    "task_completion",
    "first_check_pass",
    "repair_iterations",
    "hallucinated_api_calls",
    "invalid_api_values",
    "docs_search_count",
    "direct_docs_calls",
    "check_driven_repair_success",
    "final_errors",
    "final_warnings",
    "time_to_valid_project_seconds",
    "generated_loc",
    "cli_calls",
    "check_calls",
    "final_source_sha256",
    "protocol_deviations",
    "notes"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "condition": { "enum": ["A", "B", "C"] },
    "task_id": { "type": "string", "minLength": 1 },
    "task_prompt": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "model": { "type": ["string", "null"] },
    "reasoning_config": { "type": ["string", "null"] },
    "cli_version": { "type": "string", "minLength": 1 },
    "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "first_valid_at": { "type": ["string", "null"], "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "completed",
        "agent-timeout",
        "agent-crash",
        "infrastructure-failure",
        "protocol-violation"
      ]
    },
    "task_completion": { "type": ["boolean", "null"] },
    "first_check_pass": { "type": ["boolean", "null"] },
    "repair_iterations": { "$ref": "#/$defs/nullableCount" },
    "hallucinated_api_calls": { "$ref": "#/$defs/nullableCount" },
    "invalid_api_values": { "$ref": "#/$defs/nullableCount" },
    "docs_search_count": { "$ref": "#/$defs/count" },
    "direct_docs_calls": { "$ref": "#/$defs/count" },
    "check_driven_repair_success": { "type": ["boolean", "null"] },
    "final_errors": { "$ref": "#/$defs/nullableCount" },
    "final_warnings": { "$ref": "#/$defs/nullableCount" },
    "time_to_valid_project_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "generated_loc": { "$ref": "#/$defs/nullableCount" },
    "cli_calls": { "$ref": "#/$defs/count" },
    "check_calls": { "$ref": "#/$defs/count" },
    "final_source_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "protocol_deviations": { "$ref": "#/$defs/notes" },
    "notes": { "$ref": "#/$defs/notes" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "nullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
